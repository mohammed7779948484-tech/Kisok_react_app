# Supabase mobile client configuration
# This repository is public. Never add database passwords, service_role keys,
# JWT secrets, or any server-only credentials to this file.
#
# These EXPO_PUBLIC_ values are intended for the mobile client. Data security
# must be enforced through Supabase Row Level Security (RLS) policies.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
