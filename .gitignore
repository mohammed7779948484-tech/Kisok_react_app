# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild`, never committed
/ios
/android

# Native signing material — must never be committed
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro / build
.metro-health-check*
*.tsbuildinfo
*.tgz
*.tar.gz
.cache/

# Test output
coverage/

# Local environment.
# `.env.example` is committed and documents the variables; the real values are
# never tracked. The starter this replaced force-tracked `.env.local` with
# `!.env.local` — do not reintroduce that.
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

