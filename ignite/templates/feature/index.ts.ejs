---
destinationDir: features/<%= props.kebabCaseName %>
filename: index.ts
---
/**
 * Public API of the `<%= props.kebabCaseName %>` feature.
 *
 * This file is the ONLY thing other features and routes may import from here.
 * ESLint blocks `@/features/<%= props.kebabCaseName %>/api/...` and friends from outside this
 * directory. Inside the feature, use relative imports.
 *
 * Export the minimum another feature genuinely needs. A small public surface is
 * what lets several agents work in parallel without conflicting.
 */
<% if (props.layers.includes("screens")) { -%>
export { <%= props.pascalCaseName %>Screen } from "./screens/<%= props.kebabCaseName %>-screen";
<% } -%>
<% if (props.layers.includes("schemas")) { -%>
export type { <%= props.pascalCaseName %>Item } from "./schemas/<%= props.kebabCaseName %>-schema";
<% } -%>
<% if (props.layers.includes("queries")) { -%>
export { <%= props.camelCaseName %>Keys } from "./queries/keys";
<% } -%>
