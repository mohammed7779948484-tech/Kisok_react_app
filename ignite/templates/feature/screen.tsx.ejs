---
skip: <%= props.layers.includes("screens") ? "false" : "true" %>
destinationDir: features/<%= props.kebabCaseName %>/screens
filename: <%= props.kebabCaseName %>-screen.tsx
---
import { ScrollView, View } from "react-native";

import { EmptyState, ErrorState, SkeletonList } from "@/components/feedback";
import { Screen } from "@/components/layout/screen";
import { Text } from "@/components/ui";
<% if (props.layers.includes("components")) { -%>
import { <%= props.pascalCaseName %>List } from "../components/<%= props.kebabCaseName %>-list";
<% } -%>
<% if (props.layers.includes("queries") && props.layers.includes("api")) { -%>
import { use<%= props.pascalCaseName %>List } from "../queries/use-<%= props.kebabCaseName %>-list";
<% } -%>

/**
 * Composes this feature's UI.
 *
 * The screen may call the feature's query hooks, but never Supabase directly —
 * ESLint enforces that. Handle every state below; a screen that only handles
 * the happy path is not done.
 */
export function <%= props.pascalCaseName %>Screen() {
<% if (props.layers.includes("queries") && props.layers.includes("api")) { -%>
  const { data, isPending, isError, error, refetch } = use<%= props.pascalCaseName %>List();

  if (isPending) {
    return (
      <Screen>
        <View className="p-6">
          <SkeletonList />
        </View>
      </Screen>
    );
  }

  if (isError) {
    return (
      <Screen>
        <ErrorState error={error} onRetry={() => void refetch()} />
      </Screen>
    );
  }

  if (data.length === 0) {
    return (
      <Screen>
        <EmptyState
          title="Nothing here yet"
          description="TODO: write the real empty state for this feature."
        />
      </Screen>
    );
  }

  return (
    <Screen>
      <ScrollView contentContainerClassName="gap-4 p-6">
        <Text variant="h1"><%= props.pascalCaseName %></Text>
<% if (props.layers.includes("components")) { -%>
        <<%= props.pascalCaseName %>List items={data} />
<% } -%>
      </ScrollView>
    </Screen>
  );
<% } else { -%>
  return (
    <Screen>
      <ScrollView contentContainerClassName="gap-4 p-6">
        <Text variant="h1"><%= props.pascalCaseName %></Text>
        <Text variant="body" tone="muted">
          TODO: build this screen. See features/<%= props.kebabCaseName %>/TODO.md.
        </Text>
      </ScrollView>
    </Screen>
  );
<% } -%>
}
