# KISOK client environment.
#
# Copy to `.env.local` (git-ignored) and fill in. Every variable here is PUBLIC
# client configuration: it ships inside the app bundle and is readable by anyone
# with the APK. Security is enforced by Supabase Row Level Security, never by
# hiding these values.
#
# NEVER put any of the following in this file or anywhere in the client:
#   - the Supabase secret key (formerly `service_role`)
#   - the database password or any Postgres connection string
#   - the JWT secret
#   - the Cloudinary API secret
# `core/env` validates these at startup and fails fast with a readable message.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (`sb_publishable_...`, formerly the `anon` key).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown in the hidden maintenance screen so staff can report which backend a
# tablet is pointed at. Use: local | staging | production
EXPO_PUBLIC_ENVIRONMENT=local
