# KISOK shared TEST environment — committed on purpose.
#
# A cloned repository runs against a working backend with no setup: no Supabase
# CLI, no Docker, no local stack. Feature agents install and run.
#
# Everything here is PUBLIC client configuration. It is compiled into the app
# bundle and readable by anyone holding the APK, so committing it changes
# nothing about the project's security posture — Row Level Security is what
# protects data, never the secrecy of these values.
#
# NEVER add to this file: the Supabase secret key (formerly `service_role`), the
# database password or any Postgres connection string, the JWT secret, or the
# Cloudinary API secret. `core/env` validates what is here and fails fast.
#
# To point at a different backend, create `.env.local` (git-ignored) — Expo
# loads it after this file and it wins. That is where a staging or production
# value belongs; it must not be committed.

# The shared hosted TEST project. Disposable: its data is managed by the project
# owner, and agents must not reset, recreate or migrate it.
EXPO_PUBLIC_SUPABASE_URL=https://akxigjsifwyolkadofnj.supabase.co

# Publishable key (`sb_publishable_...`, formerly the `anon` key). This is the
# key the client is MEANT to ship with.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ptFJ-tnNAAM1okEHQKSKcA_pDzRLNMx

# Shown in the hidden maintenance screen so staff can report which backend a
# tablet points at. One of: local | test | staging | production
EXPO_PUBLIC_ENVIRONMENT=test
