---
destinationDir: features/<%= props.feature %>/state
filename: NAME-store.ts
---
import { create } from "zustand";

import { createLogger } from "@/core/logging";
import { storage, storageKey, type JsonStorage, type StorageWriteResult } from "@/core/storage";

const log = createLogger("<%= props.feature %>.<%= props.camelCaseName %>");
const STORAGE_KEY = storageKey("<%= props.feature %>", "<%= props.kebabCaseName %>");

/**
 * Client-owned state for this feature.
 *
 * Only for data the CLIENT owns — a cart, a selection, a draft. Anything that
 * came from the database belongs in a TanStack Query hook instead; two caches
 * for the same data will drift.
 *
 * Note `persistence`: KISOK deliberately surfaces storage-write failures rather
 * than swallowing them. If a write fails the change is still in memory, but the
 * UI must be able to say so — telling a customer their cart is saved when it is
 * not is a correctness bug. This is why the store writes through
 * `@/core/storage` instead of zustand's `persist` middleware, which has no hook
 * for reporting a failed write.
 *
 * `clearFailed` is a DIFFERENT failure from `memoryOnly` and must never be
 * collapsed into it: `memoryOnly` means "the current value only lives in
 * memory", which is fine to show as a minor warning. A failed CLEAR means the
 * PREVIOUS customer's data is still sitting on disk — on a shared kiosk
 * tablet, the next `hydrate()` (the next cold start, possibly for a different
 * customer) would read it straight back. That is a safety bug, not a nuisance.
 */
export type PersistenceStatus = "unknown" | "persisted" | "memoryOnly" | "clearFailed";

type <%= props.pascalCaseName %>State = {
  // TODO: replace with the real shape this feature owns.
  items: unknown[];
  persistence: PersistenceStatus;
  hydrated: boolean;
  hydrate: () => Promise<void>;
  clear: () => Promise<StorageWriteResult>;
};

/**
 * A factory, not a bare `create(...)`, so a test can inject a fake backend
 * instead of the real `AsyncStorage` singleton — in particular
 * `createJsonStorage(createMemoryStore({ failOn: "removeItem" }))` from
 * `@/core/storage` and `@/core/testing`, which exists specifically to prove
 * what `clear()` does when the durable remove fails. Real code never passes
 * an argument here; see `use<%= props.pascalCaseName %>Store` below.
 */
export function create<%= props.pascalCaseName %>Store(backend: JsonStorage = storage) {
  return create<<%= props.pascalCaseName %>State>((set, get) => ({
    items: [],
    persistence: "unknown",
    hydrated: false,

    async hydrate() {
      if (get().hydrated) return;

      // TODO: validate the restored value with a Zod schema rather than casting.
      // A payload written by an older build may no longer match this shape.
      const result = await backend.read(STORAGE_KEY, (raw) => raw as unknown[]);

      if (result.status === "hit") {
        set({ items: result.value, hydrated: true, persistence: "persisted" });
        return;
      }

      // A miss is normal on a fresh tablet. A rejection means the stored payload
      // was unreadable — start clean rather than blocking startup.
      if (result.status === "rejected") {
        log.warn("Stored state was unreadable; starting empty");
      }
      set({ hydrated: true, persistence: result.status === "miss" ? "persisted" : "memoryOnly" });
    },

    async clear() {
      // The customer in front of the tablet right now sees an empty state
      // immediately, regardless of what happens on disk below.
      set({ items: [] });

      const removed = await backend.remove(STORAGE_KEY);
      if (removed.status === "persisted") {
        set({ persistence: "persisted" });
        return removed;
      }

      // `removeItem` failed. Fall back to overwriting the key with an explicit
      // empty value — a tiny payload through the SAME write path `persist()`
      // uses, so a native remove failure that does not also break a plain
      // write still ends with disk correctly empty rather than stale.
      const overwritten = await backend.write(STORAGE_KEY, []);
      if (overwritten.status === "persisted") {
        set({ persistence: "persisted" });
        return overwritten;
      }

      // Both failed: the previous data is genuinely still on disk. This must
      // NEVER be reported as `memoryOnly` — see the note on `PersistenceStatus`
      // above. There is nothing more this store can do about it; the caller
      // decides whether to retry, warn, or refuse to proceed.
      log.error("Failed to durably clear stored state; stale data remains on disk", {
        key: STORAGE_KEY,
      });
      set({ persistence: "clearFailed" });
      return overwritten;
    },
  }));
}

export const use<%= props.pascalCaseName %>Store = create<%= props.pascalCaseName %>Store();

/**
 * Write the current state and report whether it was durably saved.
 * Call this after every mutation and reflect the result in the UI.
 */
export async function persist<%= props.pascalCaseName %>(): Promise<StorageWriteResult> {
  const { items } = use<%= props.pascalCaseName %>Store.getState();
  const result = await storage.write(STORAGE_KEY, items);
  use<%= props.pascalCaseName %>Store.setState({
    persistence: result.status === "persisted" ? "persisted" : "memoryOnly",
  });
  return result;
}
