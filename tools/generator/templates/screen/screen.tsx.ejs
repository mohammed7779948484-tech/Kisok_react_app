---
destinationDir: features/<%= props.feature %>/screens
filename: NAME-screen.tsx
---
<% if (props.withQuery) { -%>
import { ScrollView, View } from "react-native";

import { ErrorState, SkeletonList } from "@/components/feedback";
import { Screen } from "@/components/layout/screen";
import { Text } from "@/components/ui";

import { use<%= props.pascalCaseName %> } from "../queries/use-<%= props.kebabCaseName %>";
<% } else { -%>
import { ScrollView } from "react-native";

import { Screen } from "@/components/layout/screen";
import { Text } from "@/components/ui";
<% } -%>

/**
 * Composes this feature's UI.
 *
 * The screen may call the feature's own hooks, but never Supabase directly —
 * ESLint enforces that. Handle every state the data can be in; a screen that
 * only handles the happy path is not done.
 */
export function <%= props.pascalCaseName %>Screen() {
<% if (props.withQuery) { -%>
  // Add `data` to this destructure once you render it.
  const { isPending, isError, error, refetch } = use<%= props.pascalCaseName %>();

  if (isPending) {
    return (
      <Screen>
        <View className="p-6">
          <SkeletonList />
        </View>
      </Screen>
    );
  }

  if (isError) {
    return (
      <Screen>
        <ErrorState error={error} onRetry={() => void refetch()} />
      </Screen>
    );
  }

  // TODO: if the result is a collection, add an empty state here with somewhere
  // for the customer to go next — a dead end on a kiosk means an employee gets
  // asked for help. Use `EmptyState` from @/components/feedback.
  return (
    <Screen>
      <ScrollView contentContainerClassName="gap-4 p-6">
        <Text variant="h1"><%= props.pascalCaseName %></Text>
        <Text variant="body" tone="muted">
          TODO: render the loaded data.
        </Text>
      </ScrollView>
    </Screen>
  );
<% } else { -%>
  return (
    <Screen>
      <ScrollView contentContainerClassName="gap-4 p-6">
        <Text variant="h1"><%= props.pascalCaseName %></Text>
        <Text variant="body" tone="muted">
          TODO: build this screen. See features/<%= props.feature %>/TODO.md.
        </Text>
      </ScrollView>
    </Screen>
  );
<% } -%>
}
