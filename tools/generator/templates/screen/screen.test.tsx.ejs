---
skip: <%= props.withQuery ? "false" : "true" %>
destinationDir: features/<%= props.feature %>/screens/<%= props.kebabCaseName %>
filename: NAME-screen.test.tsx
---
import { AppError } from "@/core/errors";
import { renderWithProviders, screen, waitFor } from "@/core/testing";

import { <%= props.pascalCaseName %>Screen } from "./<%= props.kebabCaseName %>-screen";

/**
 * Mock the feature's own api module — that is the seam the architecture is
 * built around. Do not mock `@/core/supabase` here: a screen test should not
 * know that Supabase exists.
 */
jest.mock("../../api/fetch-<%= props.kebabCaseName %>", () => ({
  fetch<%= props.pascalCaseName %>: jest.fn(),
}));

// eslint-disable-next-line @typescript-eslint/no-require-imports
const { fetch<%= props.pascalCaseName %> } = require("../../api/fetch-<%= props.kebabCaseName %>") as {
  fetch<%= props.pascalCaseName %>: jest.Mock;
};

describe("<%= props.pascalCaseName %>Screen", () => {
  beforeEach(() => {
    fetch<%= props.pascalCaseName %>.mockReset();
  });

  it("renders the loaded data", async () => {
    fetch<%= props.pascalCaseName %>.mockResolvedValue({ id: "8f1b0a1e-2c3d-4e5f-8a9b-0c1d2e3f4a5b" });

    // `render` is async in @testing-library/react-native v14 — always await it.
    await renderWithProviders(<<%= props.pascalCaseName %>Screen />);

    await waitFor(() => {
      expect(screen.getByText("<%= props.pascalCaseName %>")).toBeOnTheScreen();
    });
  });

  it("shows the customer-safe message and a retry when loading fails", async () => {
    fetch<%= props.pascalCaseName %>.mockRejectedValue(
      new AppError({
        kind: "network",
        userMessage: "We couldn't reach the network. Check the connection and try again.",
      }),
    );

    await renderWithProviders(<<%= props.pascalCaseName %>Screen />);

    await waitFor(() => {
      expect(screen.getByText(/couldn't reach the network/i)).toBeOnTheScreen();
    });
    expect(screen.getByRole("button", { name: "Try again" })).toBeOnTheScreen();
  });
});
