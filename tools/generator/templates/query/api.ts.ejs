---
destinationDir: features/<%= props.feature %>/api
filename: fetch-NAME.ts
---
import { AppError } from "@/core/errors";
<% if (props.withSchema) { -%>
import type { <%= props.pascalCaseName %> } from "../model/<%= props.kebabCaseName %>.schema";
<% } -%>

/**
 * A read. This module and its siblings in `api/` are the ONLY place in the
 * feature allowed to reach Supabase — ESLint enforces it. Screens, components,
 * stores and query hooks all go through here.
 *
 * Keeping the network in one module per operation is what makes the feature
 * testable: a test mocks this file, not the whole client.
 */
<% if (props.withSchema) { -%>
export async function fetch<%= props.pascalCaseName %>(): Promise<<%= props.pascalCaseName %>> {
<% } else { -%>
export async function fetch<%= props.pascalCaseName %>(): Promise<unknown> {
<% } -%>
  // TODO: implement. Replace the throw below with a real call, e.g.
  //
  //   import { callRpc } from "@/core/supabase";
  //   import { <%= props.withSchema ? props.camelCaseName + "Schema" : "yourSchema" %> } from "../model/<%= props.kebabCaseName %>.schema";
  //   return callRpc("get_customer_catalog", <%= props.withSchema ? props.camelCaseName + "Schema" : "yourSchema" %>);
  //
  // A zero-argument RPC takes NO argument object: Supabase types it `Args: never`,
  // which `{}` does not satisfy. With arguments it is callRpc(name, args, schema).
  //
  // Reads available to this client (see docs/data-and-supabase.md):
  //   current_active_profile()   — identity, table-returning (rows, not jsonb)
  //   get_customer_catalog()     — the whole customer-safe catalog snapshot
  // An active Preparation session may also select directly from `orders`,
  // `order_items` and `store_settings`. Customers may read no table directly.
  //
  // Always validate the payload with a Zod schema. `callRpc` does that for you
  // and maps failures onto AppError — do not catch and rethrow raw Postgres errors.
  throw new AppError({
    kind: "unknown",
    userMessage: "This isn't available yet.",
    technicalMessage:
      "fetch<%= props.pascalCaseName %> is not implemented — see features/<%= props.feature %>/docs/todo.md",
    code: "NOT_IMPLEMENTED",
  });
}
