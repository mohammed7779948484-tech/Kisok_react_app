---
destinationDir: features/<%= props.feature %>/__tests__
filename: NAME-schema.test.ts
---
import { <%= props.camelCaseName %>Schema } from "../schemas/<%= props.kebabCaseName %>-schema";

/**
 * Schema tests are the cheapest guard against a backend contract change.
 * Extend these as you replace the placeholder fields with the real ones.
 */
describe("<%= props.kebabCaseName %> schema", () => {
  it("accepts a well-formed payload", () => {
    const result = <%= props.camelCaseName %>Schema.safeParse({
      id: "8f1b0a1e-2c3d-4e5f-8a9b-0c1d2e3f4a5b",
    });

    expect(result.success).toBe(true);
  });

  it("rejects a payload whose id is not a uuid", () => {
    expect(<%= props.camelCaseName %>Schema.safeParse({ id: "not-a-uuid" }).success).toBe(false);
  });
});
