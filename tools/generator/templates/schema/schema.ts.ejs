import { z } from "zod";

/**
 * Runtime shape of one payload this feature reads or writes.
 *
 * Every KISOK RPC returns `jsonb`, which Supabase types as the wide `Json`
 * union — so validating here is what turns an untyped payload into something
 * the rest of the feature can trust. A backend change then fails loudly at this
 * boundary instead of surfacing as `undefined` deep inside a screen.
 *
 * TODO: replace these placeholder fields with the real ones. Check
 * `supabase/migrations/*.sql` for the authoritative column names — do NOT copy
 * field names from the Flutter reference.
 */
export const <%= props.camelCaseName %>Schema = z.object({
  id: z.uuid(),
});

export type <%= props.pascalCaseName %> = z.infer<typeof <%= props.camelCaseName %>Schema>;
