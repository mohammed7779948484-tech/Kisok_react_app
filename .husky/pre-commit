# Fast by design. `pnpm verify` belongs in CI, not in front of every commit —
# a slow hook gets bypassed with --no-verify, and a hook that is routinely
# bypassed protects nothing.

# `branch --show-current` also works on an unborn branch, where `rev-parse
# --abbrev-ref HEAD` fails and would let the commit through.
branch="$(git branch --show-current)"
if [ "$branch" = "main" ]; then
  echo "✖ Direct commits to main are not allowed."
  echo "  KISOK develops on branches and merges through a pull request, so that"
  echo "  CI and review actually run. Create a branch and commit there:"
  echo ""
  echo "      git switch -c <type>/<short-description>"
  echo ""
  exit 1
fi

pnpm exec lint-staged
